<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete de la Microsoft Store, donde el programa se llama PDFSIMPLE. Lo que va entre {{ }} lo pone store\empaquetar.ps1:
  la identidad sale de store\identidad.json (Partner Center → el producto → Identidad del producto).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{Nombre}}" Publisher="{{Editor}}" Version="{{Version}}" ProcessorArchitecture="{{Arquitectura}}" />

  <Properties>
    <DisplayName>PDFSIMPLE</DisplayName>
    <PublisherDisplayName>{{EditorVisible}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Lector de PDF sin publicidad: formularios, escribir a máquina, firma manuscrita y firma digital con certificado.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
  </Resources>

  <Applications>
    <Application Id="PDFSIMPLE" Executable="PDFSIMPLE.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PDFSIMPLE"
        Description="Lector de PDF sin publicidad: formularios, texto y firma digital"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Así Windows lo ofrece para abrir los PDF; el archivo llega como argumento. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>Documento PDF</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/pdf">.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Programa de escritorio normal (WinForms + WebView2): la Store lo pide así. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
