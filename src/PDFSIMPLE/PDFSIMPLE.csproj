<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PDFSIMPLE</AssemblyName>
    <!-- Por si se compila con obj o bin en otro sitio: que no recoja lo de aquí -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <RootNamespace>PDFSIMPLE</RootNamespace>
    <ApplicationIcon>iconos\PDFSIMPLE.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Version>1.0.1</Version>
    <Product>PDFSIMPLE</Product>
    <AssemblyTitle>PDFSIMPLE</AssemblyTitle>
    <Description>Lector de PDF sin publicidad: formularios, texto y firma digital</Description>
    <Copyright>Willy</Copyright>
    <!-- WebView2 trae también su DLL de WPF, que aquí no se usa -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pruebas" />
  </ItemGroup>

  <ItemGroup>
    <!-- Todo va dentro del .exe: el visor se sirve desde los recursos (Recursos.cs) -->
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="iconos\PDFSIMPLE.ico" LogicalName="icono.ico" />
  </ItemGroup>

</Project>
