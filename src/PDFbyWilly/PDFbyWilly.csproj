<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- El nombre del programa: PDFbyWilly (instalador propio) o PDFSIMPLE (Microsoft Store, -p:Marca=PDFSIMPLE).
         Cambia el .exe, el título, el icono (iconos\<Marca>.ico), la carpeta de ajustes y el registro (Marca.cs). -->
    <Marca Condition="'$(Marca)' == ''">PDFbyWilly</Marca>
    <AssemblyName>$(Marca)</AssemblyName>
    <!-- PDFSIMPLE se compila con obj y bin fuera (store\obj): que no recoja los de aquí -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <RootNamespace>PDFbyWilly</RootNamespace>
    <ApplicationIcon>iconos\$(Marca).ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>$(Marca)</Product>
    <AssemblyTitle>$(Marca)</AssemblyTitle>
    <Description>Lector de PDF sin publicidad: formularios, texto y firma digital</Description>
    <Copyright>Willy</Copyright>
    <!-- WebView2 trae también su DLL de WPF, que aquí no se usa -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pruebas" />
  </ItemGroup>

  <ItemGroup>
    <!-- Todo va dentro del .exe: el visor se sirve desde los recursos (Recursos.cs) -->
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="iconos\$(Marca).ico" LogicalName="icono.ico" />
  </ItemGroup>

</Project>
