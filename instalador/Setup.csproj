<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PDFSIMPLE-Setup.exe: lleva dentro las dos versiones del programa (Intel/AMD y ARM) e instala la
    que toca. Es .NET Framework 4.8, que ya viene con Windows 10 y 11: no necesita nada más.
    Antes hay que generar las dos versiones en ..\dist (lo hace publicar.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PDFSIMPLE-Setup</AssemblyName>
    <RootNamespace>PDFSIMPLESetup</RootNamespace>
    <ApplicationIcon>..\src\PDFSIMPLE\iconos\PDFSIMPLE.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <Product>PDFSIMPLE</Product>
    <AssemblyTitle>Instalar PDFSIMPLE</AssemblyTitle>
    <Description>Instalar PDFSIMPLE</Description>
    <Copyright>Willy</Copyright>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dist\PDFSIMPLE.exe" LogicalName="x64.exe" />
    <EmbeddedResource Include="..\dist\PDFSIMPLE-ARM64.exe" LogicalName="arm64.exe" />
    <EmbeddedResource Include="..\src\PDFSIMPLE\iconos\PDFSIMPLE.ico" LogicalName="icono.ico" />
  </ItemGroup>

</Project>
