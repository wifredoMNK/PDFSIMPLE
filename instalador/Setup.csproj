<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PDFSIMPLE-Setup.exe: lleva dentro PDFSIMPLE.exe (un solo .exe para Intel/AMD y ARM, .NET Framework 4.8)
    y lo instala en Archivos de programa. Antes hay que generarlo en ..\dist (lo hace publicar.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PDFSIMPLE-Setup</AssemblyName>
    <RootNamespace>PDFSIMPLESetup</RootNamespace>
    <ApplicationIcon>..\src\PDFSIMPLE\iconos\PDFSIMPLE.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <Product>PDFSIMPLE</Product>
    <AssemblyTitle>Instalar PDFSIMPLE</AssemblyTitle>
    <Description>Instalar PDFSIMPLE</Description>
    <Copyright>Willy</Copyright>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dist\PDFSIMPLE.exe" LogicalName="PDFSIMPLE.exe" />
    <EmbeddedResource Include="..\src\PDFSIMPLE\iconos\PDFSIMPLE.ico" LogicalName="icono.ico" />
  </ItemGroup>

</Project>
